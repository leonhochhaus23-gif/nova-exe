{
  "name": "nova",
  "version": "1.0.0",
  "description": "Nova, my own AI assistant",
  "author": "Nova",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dk.nova.assistant",
    "productName": "Nova",
    "files": ["main.js", "index.html", "nova.ico", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "nova.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Nova-Setup.exe"
    },
    "portable": {
      "artifactName": "Nova-Portable.exe"
    }
  }
}
